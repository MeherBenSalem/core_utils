{
    "schemaVersion": 1,
    "id": "core_utilities",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "assets/core_utilities/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.nightbeam.core_utilities.CoreUtilitiesModFabric"
        ],
        "client": [
            "com.nightbeam.core_utilities.CoreUtilitiesModFabricClient"
        ]
    },
    "mixins": [
        "core_utilities.mixins.json",
        "core_utilities.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
